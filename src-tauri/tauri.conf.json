{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HiGhostty",
  "version": "../package.json",
  "identifier": "net.mrhihi.highostty",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HiGhostty",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; img-src 'self' data: blob:; frame-src 'self' hgpage: http://hgpage.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "fileAssociations": [
      { "ext": [], "name": "Folder", "role": "Viewer", "contentTypes": ["public.folder"] }
    ],
    "icon": ["icons/icon.png"],
    "resources": {
      "vendor/share/ghostty": "ghostty",
      "vendor/share/terminfo": "terminfo"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
