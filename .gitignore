._*
.Spotlight-V100/
.Trashes
.fseventsd/

# 編輯器與本機設定
.vscode/
.idea/
*.swp
.claude/settings.local.json

# 環境變數與記錄檔
.env
.env.*
*.log
npm-debug.log*
